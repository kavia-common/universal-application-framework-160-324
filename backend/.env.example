# Copy this file to .env and fill in the values for local development.
# AWS configuration (credentials can also be resolved by IAM role if running in AWS)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# PostgreSQL connection string, e.g.:
# postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/yourdb

# Idle shutdown configuration
IDLE_THRESHOLD_MINUTES=120
SCHEDULER_INTERVAL_SECONDS=300

# API
APP_HOST=0.0.0.0
APP_PORT=8000
